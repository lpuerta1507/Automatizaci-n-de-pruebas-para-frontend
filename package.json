{
  "name": "saucedemo-playwright-cucumber",
  "version": "1.0.0",
  "description": "Suite de pruebas automatizadas para SauceDemo con Playwright + Cucumber",
  "scripts": {
    "test": "cucumber-js",
    "test:report": "cucumber-js --format json:reports/cucumber-report.json && node reports/generate-report.js",
    "test:headed": "HEADLESS=false cucumber-js"
  },
  "dependencies": {
    "@cucumber/cucumber": "^10.3.2",
    "@playwright/test": "^1.44.0",
    "multiple-cucumber-html-reporter": "^3.6.2",
    "playwright": "^1.44.0"
  }
}
